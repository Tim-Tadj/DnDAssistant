# Production API base for `npm run build` (Cloudflare Pages).
#
# Use "/api/v1" (relative) if the Worker is routed on the SAME origin as Pages
# (custom domain + Worker route, or Pages Functions). Otherwise set the full
# Worker URL, e.g. https://dnd-assistant-api.<your-subdomain>.workers.dev/api/v1
# and keep CORS enabled in the Worker.
REACT_APP_API_BASE=/api/v1
