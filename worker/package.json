{
  "name": "dnd-assistant-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker API (Hono + D1) for the D&D Assistant. Ports the Spring Boot backend.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:create": "wrangler d1 create dnd-assistant",
    "db:migrate:local": "wrangler d1 migrations apply dnd-assistant --local",
    "db:migrate:remote": "wrangler d1 migrations apply dnd-assistant --remote",
    "seed:generate": "node seed/generate.mjs",
    "seed:local": "node seed/generate.mjs && node seed/apply.mjs local",
    "seed:remote": "node seed/generate.mjs && node seed/apply.mjs remote",
    "deploy:prod": "node ../scripts/deploy.mjs"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.95.0"
  }
}
