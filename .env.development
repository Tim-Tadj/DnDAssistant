# Local dev API base baked into `npm start` (CRA reads .env.development at
# dev-server start). The Worker runs locally via `npm run dev` in worker/.
# Use 127.0.0.1, not localhost, so the SPA doesn't resolve to IPv6 (which
# wrangler dev doesn't bind).
REACT_APP_API_BASE=http://127.0.0.1:8787/api/v1